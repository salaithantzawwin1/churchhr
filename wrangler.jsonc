{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "church-member-registry",
  "main": "src/index.tsx",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "church-members-db",
      "database_id": "9fe63fa9-f288-48eb-a520-543122b10b38",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "PBKDF2_ITERATIONS": "10000"
  },
  "routes": [
    {
      "pattern": "www.mmgoodnewshr.online",
      "custom_domain": true
    }
  ]
}
